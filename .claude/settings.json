{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "INPUT=$(cat); curl -s -X POST 'http://127.0.0.1:3847/api/hooks/chat-tool-use' -H 'Content-Type: application/json' -H \"X-Tmux-Session: $TINSU_TMUX_SESSION\" --connect-timeout 2 --max-time 5 -d \"$INPUT\" >/dev/null 2>&1 || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "INPUT=$(cat); curl -s -X POST 'http://127.0.0.1:3847/api/hooks/chat-pre-tool-use' -H 'Content-Type: application/json' -H \"X-Tmux-Session: $TINSU_TMUX_SESSION\" --connect-timeout 2 --max-time 300 -d \"$INPUT\" >/dev/null 2>&1 || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "INPUT=$(cat); curl -s -X POST 'http://127.0.0.1:3847/api/hooks/chat-stop' -H 'Content-Type: application/json' -H \"X-Tmux-Session: $TINSU_TMUX_SESSION\" --connect-timeout 2 --max-time 5 -d \"$INPUT\" >/dev/null 2>&1 || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "statusLine": {
    "command": "INPUT=$(cat); curl -s -X POST 'http://127.0.0.1:3847/api/hooks/chat-status' -H 'Content-Type: application/json' -H \"X-Tmux-Session: $TINSU_TMUX_SESSION\" --connect-timeout 2 --max-time 2 -d \"$INPUT\" >/dev/null 2>&1 || true",
    "type": "command"
  }
}