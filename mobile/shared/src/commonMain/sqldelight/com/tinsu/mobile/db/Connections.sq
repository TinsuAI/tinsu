CREATE TABLE connections (
    id TEXT NOT NULL PRIMARY KEY,
    display_name TEXT NOT NULL,
    host TEXT NOT NULL,
    port INTEGER NOT NULL DEFAULT 22,
    username TEXT NOT NULL,
    transport TEXT NOT NULL DEFAULT 'ssh',
    ssh_key_alias TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    last_connected_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectAll:
SELECT * FROM connections;

selectAllSortedByOrder:
SELECT * FROM connections ORDER BY sort_order ASC, created_at DESC;

selectById:
SELECT * FROM connections WHERE id = ?;

insert:
INSERT INTO connections (id, display_name, host, port, username, transport, ssh_key_alias, sort_order, last_connected_at, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE connections SET display_name = ?, host = ?, port = ?, username = ?, transport = ?, ssh_key_alias = ?, sort_order = ?, last_connected_at = ?, updated_at = ? WHERE id = ?;

deleteById:
DELETE FROM connections WHERE id = ?;

updateSortOrder:
UPDATE connections SET sort_order = ?, updated_at = ? WHERE id = ?;
