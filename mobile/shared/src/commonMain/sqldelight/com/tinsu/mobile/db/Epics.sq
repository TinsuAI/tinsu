CREATE TABLE epics (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT,
    color TEXT NOT NULL DEFAULT 'blue',
    epic_number INTEGER,
    goal TEXT,
    sprint_id TEXT,
    project_id TEXT,
    created_at INTEGER NOT NULL,
    FOREIGN KEY (sprint_id) REFERENCES sprints(id),
    FOREIGN KEY (project_id) REFERENCES projects(id)
);

CREATE INDEX epics_project_id ON epics(project_id);
CREATE INDEX epics_sprint_id ON epics(sprint_id);

selectAll:
SELECT * FROM epics;

selectById:
SELECT * FROM epics WHERE id = ?;

insert:
INSERT INTO epics (id, title, description, color, epic_number, goal, sprint_id, project_id, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM epics WHERE id = ?;
